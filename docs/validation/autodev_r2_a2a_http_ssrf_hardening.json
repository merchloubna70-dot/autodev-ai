  "residual_risks": [
    {
      "id": "RR-1",
      "title": "DNS Rebinding / TOCTOU",
      "severity": "medium",
      "description": "Validation resolves DNS before the TCP connect. An attacker controlling an authoritative DNS server can return a public IP at validation time and switch to a private IP by connection time. Requires network-layer egress control or IP-pinning to fully close.",
      "mitigated": false
    },
    {
      "id": "RR-2",
      "title": "IPv6-Mapped IPv4 and Exotic Encodings",
      "severity": "low",
      "description": "Exotic IPv6-mapped IPv4 addresses (::ffff:192.168.1.1) or decimal-encoded IPs are normalised by the ipaddress library. Edge cases in future Python versions may surface novel bypass paths.",
      "mitigated": false
    }
  ],
