  "findings": [
    {
      "kind": "inconsistent",
      "severity": "HIGH",
      "detail": "Git tag is 'v0.1.0-alpha' but pyproject.toml version is '0.1.0' (no alpha suffix). The release.yml and docker-publish.yml workflows trigger on 'v*.*.*' tags — the existing tag 'v0.1.0-alpha' matches that glob and would have triggered a PyPI publish of 0.1.0 without the alpha label. The Homebrew formula also hardcodes a 'v0.1.0' release URL (no alpha), which does not yet exist on GitHub Releases."
    },
    {
      "kind": "missing",
      "severity": "HIGH",
      "detail": "No LICENSE file at repository root. pyproject.toml uses `license = { text = \"MIT\" }` (inline text), which is valid for PEP 639 but tooling like PyPI badge generators, GitHub license detection, and the Homebrew formula's 'license \"MIT\"' clause all expect a top-level LICENSE file. Release gate should fail without it."
    },
    {
      "kind": "missing",
      "severity": "MEDIUM",
      "detail": "No CHANGELOG file present. Release workflow uses 'generate_release_notes: true' via softprops/action-gh-release, which auto-generates notes from commits — but there is no CHANGELOG.md or CHANGES.rst for users consuming the sdist or reading the docs."
    },
    {
      "kind": "inconsistent",
      "severity": "MEDIUM",
      "detail": "Homebrew formula (packaging/homebrew/Formula/autodev-ai.rb) references release URL 'v0.1.0/autodev_ai-0.1.0.tar.gz' and SHA256 '744375fb...'. This v0.1.0 GitHub Release does not exist yet (only v0.1.0-alpha tag exists). The formula will be broken until a v0.1.0 non-alpha tag is pushed and the release created."
    },
    {
      "kind": "inconsistent",
      "severity": "LOW",
      "detail": "CI test matrix includes Python 3.10, 3.11, 3.12, but Dockerfile (docker-publish.yml) and lint.yml both pin python-version to '3.12' only. The PyInstaller spec header also states 'autodev-ai v0.1.0', consistent with pyproject.toml but inconsistent with the v0.1.0-alpha git tag."
    },
    {
      "kind": "missing",
